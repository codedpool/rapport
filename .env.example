# Copy to .env and fill in. Never commit .env.
# Every URL lives here; the code has no hardcoded URLs and the API refuses to start without them.

# ---------- Server (Render, or local) ----------

# Browser origins allowed to open the voice websocket and call the API (comma-separated)
CLIENT_ORIGINS=http://localhost:3000

# Gnani endpoints
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts

# LLM endpoints (OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Auth0 (Google login)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# MongoDB
MONGODB_URI=

# Shared secret between the Next.js server and the API (any long random string; same value on both)
INTERNAL_API_SECRET=

# Set to true behind a host proxy (Render) so the real client IP is used for rate limits
TRUST_PROXY_HEADERS=false

# Local testing only: users paste their own keys in the app
GNANI_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_API_KEY=
GEMINI_API_KEY=

# ---------- Client (Vercel: Project Settings > Environment Variables; locally: client/.env.local) ----------
# APP_BASE_URL=http://localhost:3000          # the site's own URL (https://<project>.vercel.app in production)
# API_URL=http://localhost:8000               # the API's URL (https://<service>.onrender.com in production)
# NEXT_PUBLIC_WS_URL=ws://localhost:8000      # the API's websocket URL (wss://<service>.onrender.com in production)
# AUTH0_DOMAIN= AUTH0_CLIENT_ID= AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=                               # 32+ random bytes, hex (openssl rand -hex 32)
# INTERNAL_API_SECRET=                        # same value as the server
