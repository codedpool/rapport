# Copy to .env and fill in. Never commit .env.

# Gnani (for local testing; guests paste their own key in the app)
GNANI_API_KEY=

# LLM (bring-your-own in the app; these are for local testing)
OPEN_ROUTER_API_KEY=
GEMINI_API_KEY=

# Auth0 (Google login)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# MongoDB
MONGODB_URI=
