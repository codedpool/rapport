# Copy to client/.env.local (or set in Vercel > Project Settings > Environment Variables).
# Every URL lives here; the code has no hardcoded URLs.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# This site's own URL (https://<project>.vercel.app in production)
APP_BASE_URL=http://localhost:3000
# Python API, reached server-side by the Next.js bridge (https://<service>.onrender.com in production)
API_URL=http://localhost:8000
# Voice websocket, reached directly by the browser (wss://<service>.onrender.com in production)
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Same value as the API's INTERNAL_API_SECRET
INTERNAL_API_SECRET=
